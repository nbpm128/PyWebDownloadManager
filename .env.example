DM_MAX_CONCURRENT=3
DM_WORKSPACE_PATH=./downloads
DM_OUTPUT_PATH=./output
DM_PRESETS_PATH=./presets
DM_LOG_LEVEL=DEBUG
DM_LOG_DIR=logs
DM_LOG_MAX_BYTES=10485760
DM_LOG_BACKUP_COUNT=5

# ComfyUI root path (used to build folder_path presets), e.g. C:\ComfyUI or /workspace/ComfyUI
# DM_COMFY_ROOT=C:\ComfyUI

# Basic Auth credentials (optional)
# DM_USERNAME=admin
# DM_PASSWORD=admin
